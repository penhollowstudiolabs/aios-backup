# Base Dockerfile for sandboxing an open-source agent harness
# Copy and adapt. Replace prime-agent install with the target harness's installer.
# KEY IDEA: install as root (global npm install needs /usr/local), run as non-root.
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

# Unprivileged user the agent runs as
RUN useradd -m -s /bin/bash agent

# Install harness globally as root, verify it runs in the build
RUN curl -fsSL <INSTALLER_URL> | sh \
    && <harness> --version

# Confine all agent work here
RUN mkdir -p /work && chown agent:agent /work
WORKDIR /work
USER agent

# NOTE: override this ENTRYPOINT at run time with `--entrypoint sleep` if you
# use a `sleep infinity` keep-alive container, else it becomes `<harness> sleep`.
ENTRYPOINT ["/usr/local/bin/<harness>"]
